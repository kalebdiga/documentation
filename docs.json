{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "BlitzBoard",
  "colors": {
    "primary": "#0F766E",
    "light": "#14B8A6",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "concepts"
            ]
          },
          {
            "group": "API reference",
            "icon": "code",
            "pages": [
              "api-reference/introduction",
              {
                "group": "Seasons",
                "pages": [
                  "api-reference/endpoint/list-seasons"
                ]
              },
              {
                "group": "Teams",
                "pages": [
                  "api-reference/endpoint/list-teams",
                  "api-reference/endpoint/create-team",
                  "api-reference/endpoint/get-team",
                  "api-reference/endpoint/update-team",
                  "api-reference/endpoint/delete-team",
                  "api-reference/endpoint/get-player-statistics"
                ]
              },
              {
                "group": "Players",
                "pages": [
                  "api-reference/endpoint/list-players",
                  "api-reference/endpoint/create-player",
                  "api-reference/endpoint/get-player",
                  "api-reference/endpoint/update-player",
                  "api-reference/endpoint/delete-player"
                ]
              },
              {
                "group": "Schedules",
                "pages": [
                  "api-reference/endpoint/list-schedules",
                  "api-reference/endpoint/create-schedule",
                  "api-reference/endpoint/get-schedule",
                  "api-reference/endpoint/update-schedule",
                  "api-reference/endpoint/delete-schedule"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/blitzboard.png",
    "dark": "/logo/blitzboard.png",
    "href": "/"
  },
  "api": {
    "openapi": [
      "openapi.json"
    ],
    "baseUrl": "https://sandbox.blitzboardstats.com/api",
    "playground": {
      "display": "interactive",
      "proxy": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "cursor"
    ]
  }
}
